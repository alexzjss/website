{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/cv", "destination": "/cv/index.html" },
    { "source": "/projetos", "destination": "/projetos/index.html" },
    { "source": "/conteudos", "destination": "/conteudos/index.html" },
    { "source": "/projetos/:id", "destination": "/projetos/:id/index.html" },
    { "source": "/conteudos/:slug", "destination": "/conteudos/:slug/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
